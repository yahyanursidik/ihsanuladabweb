---
import '../styles/global.css';
import '../styles/site-experience.css';
import '../styles/layout-refinement.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yayasan Pendidikan Ihsanul Adab',
  description = 'Menghidupkan adab, menumbuhkan ilmu, dan mengokohkan generasi melalui layanan pendidikan Islam untuk anak, keluarga, dan masyarakat.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#087765" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/logo-yayasan-pendidikan-ihsanul-adab.png" />
    <link rel="icon" type="image/png" href="/images/logo-ihsanul-adab.png" />
    <title>{title}</title>
  </head>
  <body class="site-page">
    <slot />
    <script>
      const menuAreaSelector = '.site-header, .hm-masthead, .hm-iaiee-header, nav[aria-label*="bawah"]';
      const menus = [...document.querySelectorAll<HTMLDetailsElement>(`${menuAreaSelector.split(', ').map((area) => `${area} details`).join(', ')}`)];
      const closeMenu = (menu: HTMLDetailsElement, restoreFocus = false) => {
        menu.open = false;
        menu.querySelector('summary')?.setAttribute('aria-expanded', 'false');
        if (restoreFocus) menu.querySelector('summary')?.focus();
      };
      menus.forEach((menu) => menu.querySelector('summary')?.setAttribute('aria-expanded', String(menu.open)));

      const closeSiblingMenus = (activeDetails: HTMLDetailsElement) => {
        menus.forEach((details) => {
          if (details !== activeDetails) closeMenu(details);
        });
      };

      document.addEventListener('toggle', (event) => {
        const target = event.target;
        if (
          target instanceof HTMLDetailsElement &&
          target.closest(menuAreaSelector)
        ) {
          target.querySelector('summary')?.setAttribute('aria-expanded', String(target.open));
          if (target.open) closeSiblingMenus(target);
        }
      }, true);

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const disclosure = target.closest('summary')?.parentElement;
        if (disclosure instanceof HTMLDetailsElement && menus.includes(disclosure) && !disclosure.open) {
          closeSiblingMenus(disclosure);
        }

        if (target.closest('a')?.closest(menuAreaSelector)) {
          menus.forEach((details) => closeMenu(details));
          return;
        }

        if (target.closest('details')?.closest(menuAreaSelector)) return;

        menus.forEach((details) => closeMenu(details));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;

        menus.filter((details) => details.open).forEach((details) => closeMenu(details, true));
      });

      const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]')]
        .filter((link) => !link.closest('details') && document.getElementById(link.hash.slice(1)));
      const targets = [...new Set(sectionLinks.map((link) => document.getElementById(link.hash.slice(1))!))];
      let pending = false;
      const updateLocation = () => {
        pending = false;
        const active = targets.filter((section) => section.getBoundingClientRect().top <= window.innerHeight * 0.4)
          .sort((a, b) => b.getBoundingClientRect().top - a.getBoundingClientRect().top)[0];
        sectionLinks.forEach((link) => {
          const current = link.hash.slice(1) === active?.id;
          link.classList.toggle('is-section-current', current);
          if (current) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };
      document.addEventListener('scroll', () => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(updateLocation);
      }, { passive: true });
      window.addEventListener('resize', updateLocation);
      updateLocation();
    </script>
  </body>
</html>
